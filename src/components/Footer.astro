---
import { siteConfig } from "../config/site.config";
import brandLogo from "../assets/logo.png?url";
import LibroReclamaciones from "./LibroReclamaciones";

interface Props {
  /** Texto opcional bajo el logo (p. ej. página Nosotros). */
  overlapLead?: string;
}

const { overlapLead } = Astro.props;

const socialWrapClass =
  "flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-footer transition group-hover:bg-white/95";
const iconClass = "h-5 w-5 fill-current";
/** Fila: icono + nombre; toda la fila es clicable. */
const socialRowClass =
  "group flex min-h-[2.75rem] items-center gap-3 rounded-xl py-1 pr-2 text-left outline-none ring-white transition hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-footer sm:pr-3";
---

<section class="relative" aria-label="Pie de página">
  <!-- Franja crema superior: el borde inferior es la “junta” con el azul -->
  <div class="bg-[#FFF5F0] mt-6 mb-16 md:mt-8 md:mb-20" aria-hidden="true">
  </div>

  <footer id="contacto" class="relative z-10 bg-footer text-white">
    <!-- Logo: misma anchura máxima que las columnas para alinear el bloque centrado -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-30 -translate-y-1/2"
    >
      <div class="container flex justify-center">
        <div class="pointer-events-auto flex w-full max-w-6xl justify-start">
          <div
            class="rounded-2xl bg-white px-2 py-1 shadow-card sm:px-6 sm:py-4 md:rounded-[1.25rem] md:px-2 md:py-1"
          >
            <a
              href="/"
              class="inline-flex outline-none ring-primary focus-visible:rounded-lg focus-visible:ring-2 focus-visible:ring-offset-2"
            >
              <img
                src={brandLogo}
                alt={siteConfig.name}
                class="h-12 w-auto sm:h-16"
                loading="lazy"
                decoding="async"
              />
            </a>
            {
              overlapLead ? (
                <p class="mt-3 max-w-md text-sm leading-relaxed text-primary/85">
                  {overlapLead}
                </p>
              ) : null
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Hueco para el logo que “cuelga” del borde superior -->
    <div
      class="container pb-10 pt-[5.25rem] md:pb-14 md:pt-[5.75rem] lg:pb-16 lg:pt-24"
    >
      <div class="mx-auto w-full max-w-6xl">
        <div
          class="grid grid-cols-1 gap-12 sm:gap-14 md:grid-cols-3 md:gap-x-10 md:gap-y-0 lg:gap-x-14 xl:gap-x-20"
        >
          <div class="min-w-0">
            <div class="mb-4 text-base font-semibold tracking-tight md:text-lg">
              Explora
            </div>
            <ul class="space-y-2.5 text-sm leading-relaxed text-white/95">
              <li>
                <a
                  href="/"
                  class="inline-flex rounded-md px-2 py-1 font-medium text-white/95 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-footer"
                  >Inicio</a
                >
              </li>
              <li>
                <a
                  href="/estrategia"
                  class="inline-flex rounded-md px-2 py-1 font-medium text-white/95 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-footer"
                  >Estrategia</a
                >
              </li>
              <li>
                <a
                  href="/nosotros"
                  class="inline-flex rounded-md px-2 py-1 font-medium text-white/95 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-footer"
                  >Quiénes somos</a
                >
              </li>
            </ul>

          </div>

          <div class="min-w-0">
            <div class="mb-4 text-base font-semibold tracking-tight md:text-lg">
              Contacto
            </div>
            <ul class="space-y-2.5 text-sm leading-relaxed text-white/95">
              <li>
                <a
                  href={`mailto:${siteConfig.contact.email}`}
                  class="inline-flex rounded-md px-2 py-1 break-all font-medium text-white/95 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-footer"
                >
                  {siteConfig.contact.email}
                </a>
              </li>
              <li>
                <a
                  href={`tel:${siteConfig.contact.phoneE164}`}
                  class="inline-flex rounded-md px-2 py-1 font-medium text-white/95 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-footer"
                >
                  {siteConfig.contact.phone}
                </a>
              </li>
            </ul>
          </div>

          <div class="min-w-0">
            <div class="mb-4 text-base font-semibold tracking-tight md:text-lg">
              Síguenos en nuestras redes
            </div>
            <ul class="flex list-none flex-col gap-0.5 p-0 sm:gap-1">
              <li>
                <a
                  href={siteConfig.social.facebook}
                  class={socialRowClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class={socialWrapClass} aria-hidden="true">
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        d="M9.101 23.691v-9.8H7.169v-3.9h1.932V8.156c0-1.62.457-2.964 1.372-4.037.934-1.073 2.192-1.608 3.771-1.608h2.85v3.9h-1.822c-.978 0-1.588.454-1.82 1.364v2.996h3.43l-.409 3.9h-3.02v9.801H9.1z"
                      ></path>
                    </svg>
                  </span>
                  <span
                    class="min-w-0 text-sm font-semibold tracking-tight text-white/95 group-hover:text-white"
                  >
                    {siteConfig.socialHandle.facebook}
                  </span>
                </a>
              </li>
              <li>
                <a
                  href={siteConfig.social.instagram}
                  class={socialRowClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class={socialWrapClass} aria-hidden="true">
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"
                      ></path>
                    </svg>
                  </span>
                  <span
                    class="min-w-0 text-sm font-semibold tracking-tight text-white/95 group-hover:text-white"
                  >
                    {siteConfig.socialHandle.instagram}
                  </span>
                </a>
              </li>
              <li>
                <a
                  href={siteConfig.social.instagramEstrategia}
                  class={socialRowClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class={socialWrapClass} aria-hidden="true">
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"
                      ></path>
                    </svg>
                  </span>
                  <span
                    class="min-w-0 text-sm font-semibold tracking-tight text-white/95 group-hover:text-white"
                  >
                    {siteConfig.socialHandle.instagramEstrategia}
                  </span>
                </a>
              </li>
              <li>
                <a
                  href={siteConfig.social.instagramStore}
                  class={socialRowClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class={socialWrapClass} aria-hidden="true">
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"
                      ></path>
                    </svg>
                  </span>
                  <span
                    class="min-w-0 text-sm font-semibold tracking-tight text-white/95 group-hover:text-white"
                  >
                    {siteConfig.socialHandle.instagramStore}
                  </span>
                </a>
              </li>
              <li>
                <a
                  href={siteConfig.social.tiktok}
                  class={socialRowClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class={socialWrapClass} aria-hidden="true">
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
                      ></path>
                    </svg>
                  </span>
                  <span
                    class="min-w-0 text-sm font-semibold tracking-tight text-white/95 group-hover:text-white"
                  >
                    {siteConfig.socialHandle.tiktok}
                  </span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div
        class="mx-auto mt-14 flex w-full max-w-6xl flex-col gap-5 border-t border-white/20 pt-8 md:mt-16 md:flex-row md:items-center md:justify-between md:gap-8 md:pt-9"
      >
        <p class="text-xs leading-relaxed text-white/75">
          © {new Date().getFullYear()}
          {siteConfig.name}. Todos los derechos reservados.
        </p>
        <div class="w-full md:ml-auto md:w-auto">
          <LibroReclamaciones client:visible />
        </div>
      </div>
    </div>
  </footer>
</section>
