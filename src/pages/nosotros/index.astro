---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/nosotros/Hero";
import SplitSection from "../../components/nosotros/SplitSection";
import Staff from "../../components/nosotros/Staff";
import { nosotrosSplitSections } from "../../data/nosotrosPage";
import { nosotrosSeo } from "../../config/seoConfig";
---

<Layout seo={nosotrosSeo}>
  <Header active="nosotros" ctaLabel="Contáctanos" />
  <main class="overflow-x-hidden">
    <Hero client:load />
    {nosotrosSplitSections.map((block) => (
      <SplitSection block={block} client:visible />
    ))}
    <Staff client:visible />
  </main>
  <Footer />
</Layout>
